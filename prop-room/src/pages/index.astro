<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="A rehearsal workbench for theatre props. Catch cue collisions, test substitutions, and print a clear backstage handoff sheet."/><title>Prop Room — every prop, in its place</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head>
<body>
<header><a href="/" class="wordmark" aria-label="Prop Room home"><span class="mark" aria-hidden="true">P<span>R</span></span> PROP ROOM</a><span class="header-note">A BACKSTAGE WORKBENCH</span><button id="help" class="text-button">How it works <span aria-hidden="true">↗</span></button></header>
<main>
<section class="intro"><div><p class="eyebrow">REHEARSAL / 001</p><h1>Every prop.<br/><em>Right on cue.</em></h1><p class="lede">Find the collisions before opening night.</p></div><div class="show-note"><span class="eyebrow">ON THE CALL SHEET</span><h2>The last platform</h2><p>Three scenes. One rainy station.<br/>A few things in the wrong place.</p><span class="sample">Original sample production</span></div></section>
<div id="notice" role="status" class="notice" hidden></div>
<section class="workspace" aria-label="Rehearsal cue board">
<div class="board-heading"><div><p class="eyebrow">YOUR REHEARSAL WORKSPACE</p><p class="source"><span class="dot"></span><span id="source">Loading Sanity cues…</span></p></div><div class="toolbar"><button id="undo" class="text-button" disabled>Undo</button><button id="reset" class="text-button">Reset rehearsal</button><button id="export" class="text-button">Print crew sheet ↗</button></div></div>
<div class="summary"><div><span id="issue-count" class="count">—</span><div><strong id="issue-label">Checking cues</strong><p id="summary-text">Reading the production…</p></div></div><button id="review" class="primary" disabled>Review next conflict <span aria-hidden="true">→</span></button></div>
<div class="board-layout"><section class="cue-list" aria-label="Scene cues"><div class="list-heading"><h2>Cue sheet</h2><span>Minutes from curtain</span></div><div id="cues" aria-live="polite"></div><button id="add" class="add-button">+ Add a cue</button></section><aside id="detail" class="detail" aria-label="Cue details"><div class="detail-placeholder">Select a cue to inspect its handoff.</div></aside></div>
<div class="board-footer"><span id="confirmed">0 of 6 handoffs confirmed</span><span id="saved">Changes stay in this browser.</span></div>
</section>
<section class="inventory"><div class="list-heading"><div><p class="eyebrow">OFFSTAGE</p><h2>The prop table</h2></div><span id="prop-count">5 pieces</span></div><div id="props" class="props"></div></section>
<footer><span>Built with Astro + Sanity</span><a href="https://github.com/iamaanahmad/submissions/tree/submission/prop-room/prop-room" target="_blank" rel="noreferrer">Source &amp; judge guide ↗</a><a href="https://www.sanity.io/manage/personal/project/gdohz22j" target="_blank" rel="noreferrer">Production owner ↗</a></footer>
</main>
<dialog id="guide"><button class="close" data-close aria-label="Close guide">×</button><p class="eyebrow">WELCOME TO THE WINGS</p><h2>A quiet rehearsal.<br/>A smoother show.</h2><ol><li><strong>Read the cue sheet.</strong> Published scenes and props load from Sanity.</li><li><strong>Rehearse a fix.</strong> Review a conflict. Change the prop or timing, then confirm the handoff.</li><li><strong>Share the plan.</strong> Print your crew sheet with every cue, reset note, and unresolved issue.</li></ol><p>This public workbench uses fictional sample data. Your rehearsal stays in this browser; it never changes the shared production.</p><button class="primary" data-close>Back to rehearsal →</button></dialog>
<dialog id="add-dialog"><button class="close" data-close aria-label="Close new cue">×</button><h2>Add a cue</h2><form id="add-form"><label>Cue name<input name="title" required maxlength="100" placeholder="The final goodbye"/></label><label>Scene<select name="sceneId" id="new-scene"></select></label><div class="form-row"><label>Start minute<input name="start" type="number" min="0" max="239" required value="35"/></label><label>End minute<input name="end" type="number" min="1" max="240" required value="40"/></label></div><label>Prop<select name="propId" id="new-prop"></select></label><div class="form-row"><label>Crew<input name="crew" required maxlength="60" placeholder="Crew name"/></label><label>Handoff side<select name="location"><option>Stage left</option><option>Stage right</option><option>Upstage</option></select></label></div><p id="add-error" role="alert"></p><button class="primary" type="submit">Add to cue sheet →</button></form></dialog>
<script src="../lib/app.js"></script>
<style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#252a26;background:#f3f0e7;font-synthesis:none;--ink:#252a26;--line:#d4d5cb;--red:#b94632;--sage:#dce3d4}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button,a,input,select{touch-action:manipulation}button{cursor:pointer}button:disabled{cursor:default;opacity:.4}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #b94632;outline-offset:4px}a{color:inherit}header{padding:25px 5%;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px}.wordmark{text-decoration:none;font-size:15px;font-weight:800;letter-spacing:2px;display:flex;align-items:center;gap:12px}.mark{background:var(--ink);color:#f3f0e7;width:37px;height:37px;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:28px;letter-spacing:-6px;padding-right:7px}.mark span{transform:translateY(4px)}.header-note,.eyebrow{font-size:10px;letter-spacing:2px;font-weight:700}.header-note{color:#646b60}.text-button{padding:10px 0;border:0;background:none;font-size:12px;color:var(--ink);text-underline-offset:4px}.text-button:hover{text-decoration:underline}main{max-width:1320px;margin:auto;padding:0 5%}.intro{display:flex;justify-content:space-between;align-items:center;padding:56px 0 46px;gap:32px}.eyebrow{margin:0 0 18px}h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(48px,6.3vw,88px);letter-spacing:-4px;line-height:.99;margin:0}h1 em{color:var(--red);font-weight:400}h2{font-family:Georgia,serif;font-weight:400;margin:0;font-size:28px}.lede{font-size:15px;color:#60665d;margin:24px 0 0}.show-note{border-left:1px solid #b9bbae;padding:10px 0 10px 35px;min-width:265px}.show-note h2{font-size:26px}.show-note p{font-size:13px;line-height:1.65;color:#646b60}.sample{font-size:10px;letter-spacing:.7px;border-bottom:1px solid #b9bbae;padding-bottom:5px}.workspace{border:1px solid #bfc4b6;background:#faf9f5;box-shadow:0 8px 30px #252a2607}.board-heading{padding:22px 26px;display:flex;justify-content:space-between;gap:12px}.board-heading .eyebrow{margin-bottom:8px}.source{font-size:11px;margin:0;color:#60665d;display:flex;align-items:center;gap:6px}.dot{background:#5d785d;height:6px;width:6px;border-radius:50%}.toolbar{display:flex;gap:22px;align-items:center}.summary{background:var(--sage);padding:22px 26px;display:flex;align-items:center;justify-content:space-between;gap:20px}.summary>div{display:flex;align-items:center;gap:18px}.count{font:54px/.9 Georgia,serif;min-width:32px}.summary strong{font-size:15px;font-weight:500}.summary p{font-size:12px;color:#535e4e;margin:6px 0 0}.primary{background:var(--ink);border:1px solid var(--ink);color:#fff;padding:14px 19px;font-size:12px;display:flex;justify-content:space-between;align-items:center;gap:24px;min-height:44px}.primary:hover{background:#40493e}.board-layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(275px,1fr)}.cue-list{padding:25px 26px;border-right:1px solid var(--line)}.list-heading{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:21px}.list-heading h2{font-size:24px}.list-heading>span{font-size:10px;color:#6b7268}.scene-heading{display:flex;gap:10px;align-items:center;font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#6b7268;margin:22px 0 8px}.scene-heading span{font-size:9px;border:1px solid #d5d8cc;padding:3px 5px}.cue{display:grid;grid-template-columns:49px 1fr 16px;gap:12px;text-align:left;width:100%;border:0;border-top:1px solid #dedfd7;background:transparent;padding:15px 8px;align-items:center}.cue:hover{background:#efeee7}.cue.selected{background:#e9eddf;border-left:3px solid #5a6d4e;padding-left:5px}.cue-time{font-family:Georgia,serif;font-size:16px;white-space:nowrap}.cue strong{font-size:13px;font-weight:500;display:block}.cue small{font-size:11px;color:#6b7268;display:block;margin-top:5px}.cue .indicator{font-size:14px;color:#6b7b5e}.cue.problem .indicator{color:var(--red);font-weight:bold}.detail{padding:30px 27px;background:#f1f2e9}.detail .eyebrow{color:#68735f}.detail h2{font-size:29px;line-height:1.1;margin-bottom:16px}.detail-placeholder{font:25px/1.4 Georgia,serif;color:#68735f;padding:40px 0}.tag{display:inline-flex;padding:5px 8px;font-size:10px;letter-spacing:.5px;background:#e4d8c8;margin-bottom:16px}.tag.good{background:#d9e3d0}.conflict{padding:14px 0;border-top:1px solid #c5cab9;border-bottom:1px solid #c5cab9;margin:10px 0 18px}.conflict strong{font-size:12px;color:#a23e2b}.conflict p{font-size:12px;line-height:1.6;margin:7px 0 0}.detail label,form label{display:flex;flex-direction:column;gap:7px;font-size:11px;margin:14px 0}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}input,select{padding:11px 10px;border:1px solid #bfc5b6;background:#fffef9;color:var(--ink);border-radius:0;min-width:0;width:100%;font-size:13px}.detail .primary{width:100%;margin-top:18px}.swap{width:100%;text-align:left;padding:12px;border:1px solid #91a07f;background:transparent;font-size:12px;margin-bottom:5px}.swap:hover{background:#dde5d3}.swap small{display:block;font-size:10px;color:#68735f;margin-top:5px}.detail-note{font-size:11px;line-height:1.6;color:#68735f}.confirm{display:flex!important;flex-direction:row!important;align-items:center;gap:10px!important;line-height:1.4}.confirm input{width:17px;height:17px;accent-color:#435e3e}.add-button{background:none;border:1px dashed #adb69f;color:#526147;padding:12px;width:100%;font-size:12px;margin-top:18px}.board-footer{display:flex;justify-content:space-between;padding:17px 26px;border-top:1px solid var(--line);font-size:10px;color:#636e59;gap:15px}.inventory{padding:42px 0 25px}.inventory .eyebrow{margin-bottom:10px}.props{display:grid;grid-template-columns:repeat(5,1fr);gap:22px}.prop{border-top:1px solid #bfc4b6;padding-top:14px}.prop-art{height:60px;display:flex;align-items:center;font-family:Georgia,serif;font-size:52px;line-height:1;margin:0 0 14px}.prop strong{display:block;font-size:12px;font-weight:500}.prop p{font-size:10px;color:#68735f;line-height:1.7;margin:6px 0}.prop .reset{font-size:10px;display:block;color:#252a26;margin-top:10px}footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding:25px 0 40px;font-size:10px;color:#73796e}footer a{text-decoration:none}footer a:hover{text-decoration:underline}.notice{padding:15px;margin-bottom:20px;background:#f0dfc6;font-size:12px;line-height:1.5}dialog{color:var(--ink);background:#f3f0e7;border:1px solid #a8ae9e;padding:35px;max-width:520px;width:calc(100% - 36px)}dialog::backdrop{background:#19201899}dialog h2{font-size:34px;margin:0 24px 20px 0}dialog p,dialog li{font-size:13px;line-height:1.7}dialog ol{padding-left:20px}dialog li{margin:16px 0}.close{position:absolute;right:15px;top:12px;background:none;border:0;font-size:27px}.print-sheet{display:none}#add-error{color:var(--red)}
@media(max-width:850px){.header-note{display:none}.intro{padding-top:40px}.show-note{min-width:210px;padding-left:22px}.board-heading{flex-direction:column}.toolbar{justify-content:space-between}.board-layout{grid-template-columns:1fr 290px}.cue-list{padding:22px 16px}.detail{padding:25px 20px}.summary{padding:20px}.summary .primary{gap:10px}.props{gap:15px}.list-heading>span{max-width:85px;text-align:right}}
@media(max-width:640px){header{padding:19px 5%}.wordmark{font-size:12px;letter-spacing:1.5px}.intro{align-items:flex-start;flex-direction:column;gap:28px;padding:36px 0}.intro h1{font-size:60px;letter-spacing:-3px}.show-note{border-left:0;border-top:1px solid var(--line);padding:20px 0 0;width:100%;min-width:0}.show-note h2{font-size:23px}.show-note .eyebrow{margin-bottom:10px}.show-note p{display:none}.sample{display:inline-block;margin-top:12px}.lede{font-size:13px}.board-heading{padding:20px 16px}.toolbar{gap:12px}.toolbar .text-button{font-size:10px}.summary{align-items:stretch;flex-direction:column;gap:17px;padding:20px 16px}.summary .primary{width:100%}.summary p{font-size:11px}.board-layout{display:flex;flex-direction:column}.cue-list{border-right:0}.detail{border-top:1px solid #bfc4b6}.detail-placeholder{padding:10px 0;font-size:20px}.board-footer{padding:16px;flex-direction:column;gap:7px}.props{grid-template-columns:repeat(2,1fr);gap:24px}.inventory{padding-top:32px}.prop-art{height:45px;font-size:42px}footer{flex-wrap:wrap;line-height:1.5}dialog{padding:28px 22px}.cue{min-height:70px}.text-button{min-height:40px}.list-heading>span{max-width:none}}
@media print{body{background:white}header,main>.intro,main>.workspace,main>.inventory,main>footer,dialog,.notice{display:none!important}.print-sheet{display:block!important;color:black;font-size:11px}.print-sheet h1{font-size:30px;letter-spacing:-1px}.print-sheet table{width:100%;border-collapse:collapse;margin-top:20px}.print-sheet th,.print-sheet td{border-bottom:1px solid #ccc;padding:10px;text-align:left}.print-sheet p{line-height:1.5}main{padding:0;max-width:none}@page{margin:15mm}}
</style>
</body></html>
